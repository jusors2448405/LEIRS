# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Email API Configuration (for complainant notifications)
# Configure these variables to enable email notifications in the mediation workflow
# 
# Email notifications are sent at key workflow stages:
# - When case is forwarded to documentation
# - When summons is issued to respondent
# - When barangay hearing is scheduled
# - When mediation session is scheduled
# - When case resolution is recorded
#
# VITE_EMAIL_API_URL: The endpoint of your email service
#   Example: https://api.mailgun.net/v3/your-domain.com/messages
#   Or: https://your-email-service.example.com/send
#
# VITE_EMAIL_API_KEY: Optional API key/token for authentication
#   If your email service requires Bearer token authentication, provide it here
#   The key will be sent as: Authorization: Bearer <VITE_EMAIL_API_KEY>
#
# NOTE: Leave these blank to disable email notifications (workflow continues normally)
#
VITE_EMAIL_API_URL=
VITE_EMAIL_API_KEY=

# Power BI Embedded Dashboard (Optional)
# To enable Power BI dashboard embedding in Analytics page:
# 1. Publish your Power BI report to Power BI Service
# 2. Go to File > Embed report > Website or portal
# 3. Copy the embed URL (should contain powerbi.com/reportEmbed)
# 4. Paste the URL below
# 
# SECURITY NOTE: 
# - Use "Publish to web" ONLY if you understand it makes the report PUBLIC
# - For secure embedding, use Power BI Embedded with proper authentication
# - See: https://learn.microsoft.com/en-us/power-bi/collaborate-share/service-embed-secure
#
VITE_POWERBI_EMBED_URL=

# Example (DO NOT use this URL, get your own from Power BI):
# VITE_POWERBI_EMBED_URL=https://app.powerbi.com/reportEmbed?reportId=your-report-id&config=your-config
