# Supabase Edge Function Environment Variables

# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Service role key (for admin operations)
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Environment (development or production)
# In development, OTP is returned in response for testing
# In production, OTP is ONLY sent via email (never in response)
ENVIRONMENT=development

# SMTP Configuration for OTP Email Delivery
# REQUIRED for email sending to work
# For Gmail, you must use an App Password (not regular password)
# Get Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password

# Example for LEIRS project:
# SUPABASE_URL=https://kyvhyhmqwcxbloiliojw.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<get from Supabase Dashboard>
# ENVIRONMENT=development
# SMTP_USER=leirs.admin@gmail.com
# SMTP_PASS=<16-character Gmail App Password>

# Notes:
# - Never commit .env.local to Git (it's gitignored)
# - Use Gmail App Password, not regular password
# - SMTP_USER should be a valid Gmail address
# - For deployed functions, configure secrets via: npx supabase secrets set
